PORT=5002
# MongoDB Atlas connection string.
# Get this from Atlas → Database → Connect → "Connect your application".
# Replace <username>, <password>, and the cluster host; keep the database name (skillswap).

MONGODB_URI=mongodb+srv://admin_768:sumayya%40123@cluster0.mvukwuj.mongodb.net/Skillswap?appName=Cluster0

# Port the Express server listens on


# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign JWTs — use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=Sumayya786
# How long an access token stays valid (jsonwebtoken "zeit/ms" format)
JWT_EXPIRES_IN=7d

# --- Email (OTP verification + password reset links) ---
# Leave SMTP_HOST blank to run in dev mode: emails are logged to the server
# console instead of sent, so signup/verify/reset all still work locally.
# For real sending, use any SMTP provider — e.g. Mailtrap (safe sandbox for
# testing), or Gmail/SendGrid/Resend's SMTP credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SkillSwap <no-reply@skillswap.dev>

# Base URL of the frontend, used to build the password-reset link
FRONTEND_URL=http://localhost:5173

# Comma-separated emails to auto-promote to admin (isAdmin: true) the
# moment they sign up. Only checked at signup — promoting anyone after
# that is done by an existing admin via PATCH /api/admin/users/:id/make-admin,
# not by editing this list. Leave blank and no accounts start as admin.
ADMIN_EMAILS=

# Razorpay Dashboard → Settings → API Keys. Use the *test* keys until you're
# ready to go live. RAZORPAY_WEBHOOK_SECRET is separate — set when you add
# the webhook (Dashboard → Webhooks → point at
# POST /api/payments/razorpay/webhook, subscribe to `payment.captured`);
# not required just to accept payments via the /verify flow.
RAZORPAY_KEY_ID=rzp_test_TIuW5E93K3KkPC
RAZORPAY_KEY_SECRET=Fhlng325hIiH7BakOjNSHCX3
RAZORPAY_WEBHOOK_SECRET=

# --- YouTube Data API v3 (lesson player) ---
# Get a key from https://console.cloud.google.com/apis/credentials after
# enabling "YouTube Data API v3" on your project. Server-side only — never
# exposed to the frontend.
YOUTUBE_API_KEY=AIzaSyDAvdKYaZedLSqVOTbr8964IE8bpMyHIK8
# How long a video list stays fresh before hitting the
# YouTube API again for it, in hours. Kept high on purpose — the free
# quota is 10,000 units/day and a single skill's search costs ~400.
YOUTUBE_CACHE_TTL_HOURS=12
